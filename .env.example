# Copia este archivo a .env y cambia todas las contraseñas y secretos antes de desplegar.
POSTGRES_DB=latent
POSTGRES_USER=latent
POSTGRES_PASSWORD=change_this_db_password_2026
DATABASE_URL=postgres://latent:change_this_db_password_2026@db:5432/latent?sslmode=disable
CLAVE_FIRMA=replace_with_at_least_32_random_characters_before_deploy
PUERTO_PUBLICO=8081
# true solo para la demostración local; en despliegue usa false.
MODO_DEMO=true
# Obligatorios cuando MODO_DEMO=false.
ANFITRION_USUARIO=
ANFITRION_CLAVE=

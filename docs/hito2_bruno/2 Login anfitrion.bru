meta {
  name: 2 POST login anfitrión · 200
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "usuario": "luis",
    "clave": "luis-2026"
  }
}

script:post-response {
  const body = res.getBody();
  if (res.getStatus() === 200 && body.datos && body.datos.token) {
    bru.setEnvVar("tokenAnfitrion", body.datos.token);
  }
}

tests {
  test("el anfitrión recibe un JWT", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().datos.token).to.be.a("string");
  });
}

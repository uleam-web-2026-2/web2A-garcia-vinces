meta {
  name: 5 PATCH como anfitrión · 200
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/eventos/{{eventIdCreado}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAnfitrion}}
}

body:json {
  {
    "estado": "activo"
  }
}

tests {
  test("el anfitrión inicia el evento creado", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().datos.estado).to.equal("activo");
  });
}
